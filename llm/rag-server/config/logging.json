{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "trace_id": {
      "()": "config.TraceIdFilter"
    }
  },
  "formatters": {
    "json_formatter": {
      "format": "{\"time\": \"%(asctime)s\", \"level\": \"%(levelname)s\",\"filename\": \"%(filename)s\", \"lineno\":\"%(lineno)d\", \"trace_id\": \"%(trace_id)s\" ,\"message\": %(message)s}",
      "class": "pythonjsonlogger.jsonlogger.JsonFormatter"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "json_formatter",
      "filters": [
        "trace_id"
      ],
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": true
    },
    "uvicorn": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [],
      "level": "WARNING",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}
