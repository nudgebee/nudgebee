# NB AI Gateway — example env. Copy to `.env` (same dir you run from) and fill in.
# Real OS env vars OVERRIDE .env values. Do NOT commit a real `.env`.

# --- server ---
PORT=8000
LOG_LEVEL=info

# --- auth (gateway is ingress-facing, so it authenticates itself) ---
# Mode: user_auths (real NB PAT lookup via sha256 on user_auths — SECURE DEFAULT),
# static (one configured token → identity, an ASSUMPTION for controlled setups),
# or none (NO auth — an open proxy to the provider keys; local dev only, and you
# must also set GATEWAY_AUTH_ALLOW_INSECURE=true or the gateway refuses to start).
# Client sends the NB token in the provider api-key slot (x-api-key /
# Authorization: Bearer / x-goog-api-key).
GATEWAY_AUTH_MODE=user_auths
# For local dev with no token store, uncomment BOTH of these:
# GATEWAY_AUTH_MODE=none
# GATEWAY_AUTH_ALLOW_INSECURE=true
# GATEWAY_STATIC_TOKEN=nb-demo-token
# GATEWAY_STATIC_TENANT_ID=tenant-42
# GATEWAY_STATIC_USER_ID=user-9

# --- per-provider API keys (serve multiple providers at once) ---
# Set any subset; the passthrough routes by endpoint (/anthropic /openai /genai).
# GATEWAY_ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# GATEWAY_OPENAI_API_KEY=sk-xxxxxxxx
# GATEWAY_GEMINI_API_KEY=AIzaxxxxxxxx

# --- operator default / cloud provider credential (LLM_PROVIDER_* block) ---
# Use for a single provider, or a cloud provider (Bedrock/Vertex/Azure) that needs
# structured creds (region/access/secret). For the 3 key-based providers above,
# prefer the per-provider keys.
# Mirrors llm-server's LLM_PROVIDER_* naming. The gateway is a passthrough, so
# this is the default credential injected for the addressed provider until
# per-tenant resolution (task 3). Configure ONE provider per run for now.
#
# Anthropic:
LLM_PROVIDER=anthropic
LLM_PROVIDER_API_KEY=sk-ant-xxxxxxxx
#
# Gemini (Google AI, API key) — set instead of the above:
# LLM_PROVIDER=gemini
# LLM_PROVIDER_API_KEY=AIzaxxxxxxxx
#
# Optional base-URL override (honored by Anthropic/OpenAI; Gemini ignores it):
# LLM_PROVIDER_API_ENDPOINT=

# --- Bedrock (cloud BYO) — set LLM_PROVIDER=bedrock and use these instead of api_key ---
# LLM_PROVIDER_REGION=us-west-2
# LLM_PROVIDER_ACCESS_KEY=
# LLM_PROVIDER_SECRET_KEY=
# LLM_PROVIDER_SESSION_TOKEN=
