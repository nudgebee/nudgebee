# Dockerfile_base
# This Dockerfile builds a base image with Playwright browsers and the playwright-go CLI.
# It uses a multi-stage build to minimize the final image size.
# Build this image first: docker build -t playwright-base-image -f Dockerfile_base .

# --- Stage 1: Build playwright-go CLI ---
FROM ghcr.io/nudgebee/golang:1.26.10 AS go-builder

ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH

ENV GOOS=${TARGETOS:-linux}
ENV GOARCH=${TARGETARCH:-amd64}
ENV CGO_ENABLED=0

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download -x

# Install the Playwright-Go CLI globally using the version from go.mod.
# Canonical module path is github.com/mxschmitt/playwright-go (the playwright-community
# path's newest tags reverted to it). v0.6100.0 also fetches the driver from the npm
# registry + nodejs.org instead of the retired playwright.azureedge.net CDN, which now
# 404s and broke this build on the older v0.5700.1 driver zip.
# Resolve the version with `go list -m` (robust against go.mod formatting) rather
# than grep/sed; the toolchain is present and `go mod download` has already run.
RUN PWGO_VER=$(go list -m -f '{{.Version}}' github.com/mxschmitt/playwright-go) && \
    go install github.com/mxschmitt/playwright-go/cmd/playwright@${PWGO_VER}

# --- Stage 1b: Rebuild the GitHub CLI (gh) on a patched Go toolchain ---
# GitHub's prebuilt `gh` lags the Go stdlib and x/* security releases, and
# `apt install gh` can't clear that (it's a prebuilt Go binary), so build gh
# from source and copy it in — llm-server shells out to `gh`
# (tools/tool_github.go). gh v2.101+ and glab v1.122+ (the first releases on
# patched x/net, x/crypto, x/image, grpc and klauspost/compress) require Go
# 1.27, so this stage builds on golang:1.27.3 while the service itself stays on
# 1.26. Same technique as the redis wait-for-port / postgres gosu mirrors.
# CGO_ENABLED=0 -> a static binary that runs on the ubuntu runtime.
FROM ghcr.io/nudgebee/golang:1.27.3 AS gh-builder
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux}
ENV GOARCH=${TARGETARCH:-amd64}
ENV CGO_ENABLED=0
ENV GOTOOLCHAIN=local
RUN go install github.com/cli/cli/v2/cmd/gh@v2.103.3
# glab (GitLab CLI) shares this stage: it is also a Go binary with no apt package
# on ubuntu:noble, so a source build on the patched toolchain is the only route
# and the CVE rationale above applies verbatim. llm-server shells out to `glab`
# from tools/tool_gitlab.go on the local-exec path (LlmServerWorkspaceEnabled=false).
# Keep this version in lockstep with llm/code-analysis/Dockerfile — that image is
# the workspace pod, and a version split there would make the same agent prompt
# behave differently depending on which execution path served the call.
RUN go install gitlab.com/gitlab-org/cli/cmd/glab@v1.126.0

# --- Stage 1c: Fetch a patched browser and Node.js runtime ---
# playwright-go pins Playwright 1.62.1, which installs Chromium 151 and Node
# 24.19.0, and has no newer release. Chrome security fixes ship faster than either
# project moves, so take chrome-headless-shell from Chrome for Testing (the same
# source Playwright downloads from) and Node from nodejs.org, and swap them in
# below. Bump these pins and checksums by hand: Grype does not recognise
# chrome-headless-shell, so a stale browser here still scans clean. Remove this
# stage once playwright-go ships a Playwright with a current browser.
FROM ubuntu:noble AS browser-fetcher
ARG TARGETARCH
ARG CHROME_VERSION=156.0.8078.80
ARG NODE_VERSION=24.22.2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip xz-utils \
    && case "${TARGETARCH}" in \
         amd64) chrome_arch=linux64; chrome_sha=547dcd374e02961bf998f6046a267644f8502225c36bb78ca307dab32a0b3eb4; \
                node_arch=x64; node_sha=48cc0e21e048790e54c0cf5749c2725005313d652651c40b7a21feb9697aaf75 ;; \
         arm64) chrome_arch=linux-arm64; chrome_sha=5bb6a00a4285c13303d3f72c5afdb70f144ea7a93eed462365a52b69631c9607; \
                node_arch=arm64; node_sha=eb187837a2230d4047161ac0be008584e16b46f726e9c9490ee35dc6b17d9ba8 ;; \
         *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSLo /tmp/chrome.zip "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/${chrome_arch}/chrome-headless-shell-${chrome_arch}.zip" \
    && echo "${chrome_sha}  /tmp/chrome.zip" | sha256sum -c - \
    && curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
    && echo "${node_sha}  /tmp/node.tar.xz" | sha256sum -c - \
    && mkdir -p /out \
    && unzip -q /tmp/chrome.zip -d /tmp \
    && mv "/tmp/chrome-headless-shell-${chrome_arch}" /out/chrome-headless-shell \
    && tar -xJf /tmp/node.tar.xz -C /tmp \
    && cp "/tmp/node-v${NODE_VERSION}-linux-${node_arch}/bin/node" /out/node

# --- Stage 2: Install Playwright browsers and copy playwright-go CLI ---
FROM ubuntu:noble AS playwright-installer

LABEL maintainer="nudgebee"
LABEL version="noble-playwright-go-optimized"

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal system dependencies, letting playwright install --with-deps handle the rest.
# apt-get upgrade patches the ubuntu:noble base packages to the latest security
# releases — the tag lags upstream, so without it the image (and llm-server, which
# builds FROM it) inherits ~90 fixable OS CVEs. DEBIAN_FRONTEND=noninteractive is
# already set above, so upgrade won't prompt.
# OS-package cache-bust: bumping OS_PKG_EPOCH (ISO week) changes this layer's
# cache key so BuildKit re-runs the apt upgrade/install and pulls current ubuntu
# security patches — its registry cache (mode=max) otherwise serves a stale
# package layer forever. Committed (not a build-arg) so each refresh is a
# reviewable, revertable diff; bump when the Trivy scan flags a stale package
# (e.g. gzip CVE-2026-41991, tar CVE-2025-45582).
# W29 pulls the freshly-published Ubuntu fixes for wget (CVE-2026-58469..72) and
# libasound2 (CVE-2026-56109) — 6 MEDIUMs that moved from NOFIX to fixable.
ARG OS_PKG_EPOCH=2026-W44
RUN echo "os-pkg-epoch: ${OS_PKG_EPOCH}" \
    && apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# gh (GitHub CLI): use the source rebuild from the gh-builder stage instead of
# `apt install gh`. GitHub's apt package lags Go security releases and carries the
# CVEs noted above; the rebuild clears them. This also drops the apt
# keyring / extra-repo setup the apt install required.
COPY --from=gh-builder /go/bin/gh /usr/bin/gh
COPY --from=gh-builder /go/bin/glab /usr/bin/glab
RUN chmod +x /usr/bin/gh /usr/bin/glab

# Copy the compiled playwright-go CLI from the previous stage
COPY --from=go-builder /go/bin/playwright /usr/local/bin/playwright
RUN chmod +x /usr/local/bin/playwright

# Install the headless shell with the playwright-go CLI, which also pulls in the
# system libraries it needs. The crawl tool launches headless, which runs this
# binary, so the full Chromium build is not installed.
RUN /usr/local/bin/playwright --version \
    && mkdir -p /root/.cache \
    && /usr/local/bin/playwright install --with-deps chromium-headless-shell \
    && rm -rf /root/.cache/ms-playwright/ffmpeg-* \
    && ls -lh /root/.cache/ms-playwright

# Replace Playwright's browser and Node with the patched ones from browser-fetcher,
# at the paths the driver expects. Playwright's arm64 layout is its own Chromium
# build, not Chrome for Testing, so the directory and file names differ per arch.
ARG TARGETARCH
COPY --from=browser-fetcher /out/chrome-headless-shell /opt/chrome-headless-shell
COPY --from=browser-fetcher /out/node /tmp/node
RUN set -eu; \
    shell_dir=$(ls -d /root/.cache/ms-playwright/chromium_headless_shell-*); \
    case "${TARGETARCH}" in \
      amd64) exe_dir=chrome-headless-shell-linux64; exe=chrome-headless-shell ;; \
      arm64) exe_dir=chrome-linux; exe=headless_shell ;; \
      *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    rm -rf "${shell_dir:?}"/chrome-*; \
    mkdir -p "${shell_dir}/${exe_dir}"; \
    ln -s /opt/chrome-headless-shell/chrome-headless-shell "${shell_dir}/${exe_dir}/${exe}"; \
    "${shell_dir}/${exe_dir}/${exe}" --version; \
    install -m 0755 /tmp/node /root/.cache/ms-playwright-go/*/node; \
    rm /tmp/node; \
    /root/.cache/ms-playwright-go/*/node --version

WORKDIR /app
