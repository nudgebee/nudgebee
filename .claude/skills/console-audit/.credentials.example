# Copy this file to `.credentials.local` (same folder) and fill in your own LDAP
# credentials. `.credentials.local` is gitignored — it never gets committed.
#
#   cp .credentials.example .credentials.local
#   # then edit .credentials.local with your values
#
# Auto-login currently supports the LDAP provider only. If you sign in with SSO,
# Google, or a magic link, log in once manually in the MCP-controlled Chrome
# window and re-run — the skill will detect the existing session and skip login.

USERNAME=<your-ldap-username>
PASSWORD=<your-ldap-password>
