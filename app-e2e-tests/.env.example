# app-e2e-tests — environment template
#
# Copy to the file matching your target environment and fill in real values:
#   .env       → E2E_ENVIRONMENT unset or "test"   (npm run test:test)
#   .env.dev   → E2E_ENVIRONMENT=dev               (npm run test:dev)
#   .env.oss   → E2E_ENVIRONMENT=oss               (npm run test:oss / dt.js default)
#
# None of those files are committed (see .gitignore). In CI the whole file body
# is stored as one GitHub Actions secret — E2E_OSS_ENV — and written to .env.oss
# by .github/workflows/e2e-oss.yaml.
#
# Legend:
#   [required]  suite cannot run without it
#   [optional]  has a fallback; the default in effect is noted
#   [skips]     the owning spec calls test.skip() when unset — suite still passes
#   *SECRET*    real credential; never commit a filled-in copy


# ─────────────────────────────────────────────────────────────────────────────
# Core — every run needs these
# ─────────────────────────────────────────────────────────────────────────────
BASE_URL=https://app.example.com          # [required] app under test
LDAP_USERNAME=                            # [required] login user (dev + test + oss paths)
LDAP_PASSWORD=                            # [required] *SECRET*
CLUSTER=                                  # [required in practice] cluster to select; also
                                          #   the account name typed into integration and
                                          #   automation dropdowns. Unset → the login falls
                                          #   back to the highest "iteration-N" cluster, but
                                          #   integration/workflow specs pass it unchecked.
CLUSTER_NAME=                             # [optional] alias; takes precedence over CLUSTER
                                          #   for cluster selection only
SWITCH_TENANT=                            # [optional] tenant to switch into after login;
                                          #   unset → stays on the login's default tenant
E2E_HEADLESS=                             # [optional] "1" forces headless locally (CI is
                                          #   always headless)

# Credentials login helper (pages/ossLoginHelper.ts). Currently unreferenced —
# every environment, oss included, logs in through the LDAP path above.
E2E_EMAIL=                                # [unused today]
E2E_PASSWORD=                             # [unused today] *SECRET*


# ─────────────────────────────────────────────────────────────────────────────
# Test-data scope
# ─────────────────────────────────────────────────────────────────────────────
KUBECTL_NAMESPACE=                        # [required by workflow/AILLM + TaskRunner specs]
                                          #   default "test-cluster" in sloConstants only
E2E_NAMESPACE=                            # [optional] Nubi question data; default "test-cluster-test"
NETWORK_PROBE_HOST=                       # [optional] default "google.com"
HTTP_TASK_URL=                            # [optional] default "https://api.github.com/zen"


# ─────────────────────────────────────────────────────────────────────────────
# Slack — run reporting + notification specs
# ─────────────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                        # [optional] *SECRET* reporter silently no-ops when unset
SLACK_CHANNEL=                            # [required by workflow/AILLM + slacknotification specs]
SLACK_IM_CHANNEL_ID=                      # [skips] workflow IM task
SLACK_IM_MESSAGE=
SLACK_TROUBLESHOOT_CHANNEL=               # [skips] admin notification-rule specs
SLACK_OPTIMIZATION_CHANNEL=
SLACK_AUTOPILOT_CHANNEL=
SLACK_SLO_CHANNEL=
SLACK_DAILY_HIGH_CHANNEL=


# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Teams
# ─────────────────────────────────────────────────────────────────────────────
MSTEAMS_GROUP_NAME=
MSTEAMS_TEAM_ID=
MSTEAMS_AUTOMATION_CHANNEL=
MSTEAMS_TROUBLESHOOT_CHANNEL=
MSTEAMS_OPTIMIZATION_CHANNEL=
MSTEAMS_AUTOPILOT_CHANNEL=
MSTEAMS_SLO_CHANNEL=
MSTEAMS_DAILY_HIGH_CHANNEL=


# ─────────────────────────────────────────────────────────────────────────────
# Google Chat
# ─────────────────────────────────────────────────────────────────────────────
GCHAT_SPACE_ID=
GCHAT_IM_MESSAGE=
GCHAT_AUTOMATION_CHANNEL=
GCHAT_TROUBLESHOOT_CHANNEL=
GCHAT_OPTIMIZATION_CHANNEL=
GCHAT_AUTOPILOT_CHANNEL=
GCHAT_SLO_CHANNEL=
GCHAT_DAILY_HIGH_CHANNEL=


# ─────────────────────────────────────────────────────────────────────────────
# Notification rule names (must already exist in the target tenant)
# ─────────────────────────────────────────────────────────────────────────────
RULE_NAME_TROUBLESHOOT=
RULE_NAME_OPTIMIZATION=
RULE_NAME_AUTOPILOT=
RULE_NAME_SLO=
RULE_NAME_DAILY_HIGH=


# ─────────────────────────────────────────────────────────────────────────────
# Users & RBAC (admin specs)
# ─────────────────────────────────────────────────────────────────────────────
USER_1_FIRST=
USER_1_LAST=
USER_1_EMAIL=                             # also the recipient in the email workflow spec
USER_1_ROLE=
USER_2_FIRST=
USER_2_LAST=
USER_2_EMAIL=
USER_2_ROLE=
USER_3_FIRST=
USER_3_LAST=
USER_3_EMAIL=
USER_3_ROLE=
EMAIL_SUBJECT=                            # subject asserted by the email workflow spec

RBAC_TEST_USERNAME=                       # [skips] role-enforcement spec logs in as this user
RBAC_TEST_PASSWORD=                       # *SECRET*
RBAC_TEST_USER_ID=                        # [optional] looked up by username when unset


# ─────────────────────────────────────────────────────────────────────────────
# Cloud accounts
# ─────────────────────────────────────────────────────────────────────────────
AWS_CLUSTER_NAME=                         # [optional] default "iteration-aws"
AZURE_CLUSTER_NAME=                       # [optional] default "iteration-azure"
GCP_CLUSTER_NAME=                         # [optional] default "iteration-gcp"

AZURE_DISPLAY_NAME=                       # [skips] Azure integration spec
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=                      # *SECRET*
AZURE_SUBSCRIPTION_ID=

GCP_DISPLAY_NAME=                         # [skips] GCP integration spec
GCP_PROJECT_ID=
GCP_BILLING_DATASET_NAME=
GCP_TABLE_NAME=
GCP_SERVICE_ACCOUNT_KEY=                  # *SECRET* service-account JSON, pasted as one line


# ─────────────────────────────────────────────────────────────────────────────
# Admin → Integrations
#
# The *_SECRET vars below are typed into the form's "K8s Secret" field: they are
# the NAME of a Kubernetes secret that already exists in the target cluster, not
# a raw credential. The token/password vars are real credentials.
# Each block is [skips] — its spec self-skips when any of its vars is unset.
# ─────────────────────────────────────────────────────────────────────────────
ARGOCD_INTEGRATION_CONFIG_NAME=
ARGOCD_SECRET=                            # K8s secret name

CLICKHOUSE_INTEGRATION_CONFIG_NAME=
CLICKHOUSE_SECRET=                        # K8s secret name

POSTGRES_NAME=
POSTGRES_SECRET=                          # K8s secret name

RABBITMQ_INTEGRATION_CONFIG_NAME=
RABBITMQ_SECRET=                          # K8s secret name

REDIS_INTEGRATION_CONFIG_NAME=
REDIS_SECRET=                             # K8s secret name

SSH_INTEGRATION_CONFIG_NAME=              # spec is currently disabled in-tree
SSH_SECRET=                               # K8s secret name

CONFLUENCE_INTEGRATION_CONFIG_NAME=
CONFLUENCE_TEST_HOST=
CONFLUENCE_NAMESPACE=
CONFLUENCE_USER_NAME=
CONFLUENCE_TOKEN=                         # *SECRET*

GITHUB_NAME=                              # integration config name (also used by ticket specs)
GITHUB_USERNAME=
GITHUB_TOKEN=                             # *SECRET*

GITLAB_INTEGRATION_NAME=
GITLAB_HOSTURL=
GITLAB_USERNAME=
GITLAB_TOKEN=                             # *SECRET*

JIRA_NAME=
JIRA_ACCOUNT_URL=
JIRA_USERNAME=
JIRA_TOKEN=                               # *SECRET*

MCP_INTEGRATION_CONFIG_NAME=
MCP_URL=
MCP_LLM_INSTRUCTIONS=                     # [optional] filled only when set

PAGER_DUTY_NAME=
PAGER_DUTY_EMAIL=
PAGER_DUTY_TOKEN=                         # *SECRET*

SERVICE_NOW_NAME=
SERVICE_NOW_INSTANCE_URL=
SERVICE_NOW_USERNAME=
SERVICE_NOW_PASSWORD=                     # *SECRET*

ZENDUTY_INTEGRATION_NAME=
ZENDUTY_EMAIL=
ZENDUTY_API_TOKEN=                        # *SECRET*


# ─────────────────────────────────────────────────────────────────────────────
# Ticket workflow fixtures — existing tickets/projects the specs act on.
# Create-ticket specs skip per tool when the tool's *_NAME var is unset.
# ─────────────────────────────────────────────────────────────────────────────
JIRA_PROJECT_KEY=
JIRA_PROJECT_NAME=
JIRA_ISSUE_TYPE=
JIRA_TICKET_ID=
JIRA_TRANSITION_STATUS=

GITHUB_PROJECT_KEY=
GITHUB_REPO_NAME=
GITHUB_ISSUE_TYPE=
GITHUB_TICKET_ID=
GITHUB_ASSIGNEE=

GITLAB_PROJECT_NAME=
GITLAB_ISSUE_TYPE=

SERVICE_NOW_TABLE=
SERVICE_NOW_ISSUE_TYPE=

PAGER_DUTY_SERVICE_NAME=
PAGER_DUTY_ISSUE_TYPE=
PAGER_DUTY_TICKET_ID=

ZENDUTY_ISSUE_TYPE=


# ─────────────────────────────────────────────────────────────────────────────
# AlertManager monitoring spec — all optional, defaults shown
# ─────────────────────────────────────────────────────────────────────────────
ALERT_MANAGER_ALERT_NAME=                 # default "test-alert"
ALERT_MANAGER_SEVERITY=                   # default "critical"
ALERT_MANAGER_SOURCE=                     # default "prometheus"
ALERT_MANAGER_PROMQL=                     # default "vector(1)"
ALERT_MANAGER_TIME=                       # default "1"


# ─────────────────────────────────────────────────────────────────────────────
# QA sheet sync (sync-workflow-to-sheets.js / fix-workflow-sheet.js).
# Standalone helper scripts — not needed to run the Playwright suite.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=           # *SECRET* path to the service-account JSON;
                                          #   default "credentials/sheets-credentials.json"
TC_TESTER_NAMES=                          # comma-separated
TC_executedBy=
